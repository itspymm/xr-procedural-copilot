  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::XRProceduralCopilot.Procedure.ProcedureDefinition
  tutorialId: paper_airplane
  procedureTitle: How to Make a Paper Airplane
  videoUrl: 
  steps:
  - stepNumber: 1
    title: Start with a rectangular sheet of paper
    instruction: Start with a rectangular sheet of paper. Fold it in half lengthwise,
      crease it firmly, and then unfold it.
    additionalGuidance: Make sure the edges are aligned and crease firmly.
    videoStartSeconds: 0
    videoEndSeconds: 10
  - stepNumber: 2
    title: Fold both top corners inward until their edge
    instruction: Fold both top corners inward until their edges meet along the center
      crease.
    additionalGuidance: Make sure the edges are aligned and crease firmly.
    videoStartSeconds: 10
    videoEndSeconds: 20
  - stepNumber: 3
    title: Fold the paper in half along the original cen
    instruction: Fold the paper in half along the original center crease. Fold both
      sides downward to form the wings.
    additionalGuidance: Make sure the edges are aligned and crease firmly.
    videoStartSeconds: 20
    videoEndSeconds: 35
